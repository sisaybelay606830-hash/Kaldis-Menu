{
    "name": "kaldis/digital-menu",
    "description": "Kaldis Coffee PLC Digital Menu System",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "chillerlan/php-qrcode": "^5.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "import": "php scripts/import_products.php",
        "install-db": "php scripts/install_db.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}

